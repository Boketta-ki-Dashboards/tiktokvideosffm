{
  "name": "smokingtiktok-studio",
  "version": "0.1.0",
  "private": true,
  "description": "SmokingTikTok Studio – cloudbasiertes Produktionssystem für animierte TikTok-Erklärvideos (Remotion + React + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "check": "npm run typecheck && npm run lint && npm test",
    "compositions": "remotion compositions",
    "still": "node scripts/render-still.mjs",
    "render": "node scripts/render.mjs",
    "verify": "node scripts/verify-video.mjs",
    "voice:import": "node scripts/voice/import-voice.mjs",
    "voice:piper": "node scripts/voice/piper-tts.mjs",
    "voice:setup-piper": "bash scripts/voice/setup-piper.sh",
    "captions:whisper": "node scripts/voice/transcribe-whisper.mjs",
    "test": "node --test tests/*.test.ts",
    "voice:estimate": "node scripts/voice/estimate-manifest.mjs",
    "sfx": "node scripts/audio/generate-sfx.mjs",
    "voice:setup-chatterbox": "bash scripts/voice/setup-chatterbox.sh",
    "voice:chatterbox": "node scripts/voice/chatterbox-tts.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@remotion/captions": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/install-whisper-cpp": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "@remotion/paths": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "@remotion/zod-types": "4.0.540",
    "d3-geo": "3.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "eslint": "9.39.5",
    "globals": "14.0.0",
    "typescript": "5.9.3"
  }
}
